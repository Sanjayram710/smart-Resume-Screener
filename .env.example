# Application Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Smart Resume Screener"
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# Database Configuration
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/resume_screener
# For Local Postgres: postgresql://postgres:postgres@localhost:5432/resume_screener
# For Local SQLite (Zero Setup): sqlite:///./resume_screener.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_screener

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# LLM Provider Configuration
# Options: mock | real
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=2

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf","txt"]

# Deterministic Scoring Weights (Must sum to 1.0)
SCORE_WEIGHT_SKILLS=0.40
SCORE_WEIGHT_EXPERIENCE=0.25
SCORE_WEIGHT_SEMANTIC=0.20
SCORE_WEIGHT_EDUCATION=0.10
SCORE_WEIGHT_CERTIFICATIONS=0.05

# Recommendation Thresholds (Scale 1.0 - 10.0)
SHORTLIST_THRESHOLD=7.0
REVIEW_THRESHOLD=5.0

# Semantic Matching Settings
SEMANTIC_SIMILARITY_THRESHOLD=0.65
